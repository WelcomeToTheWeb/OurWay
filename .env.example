# OurWay server environment template.
# Copy to .env (or export in your shell / container runtime).
# Every variable has a sensible default; none are strictly required,
# but JWT_SECRET and DATABASE_URL must be set sensibly in production.

# HTTP listen address (host:port)
SERVER_PORT=":8080"

# PostgreSQL connection string
DATABASE_URL="postgresql://ourway:ourway@localhost:5432/ourway?sslmode=disable"

# Secret key for JWT token signing. Generate your own and keep it private:
#   openssl rand -hex 32
# Leaving this unset gives the server a fresh random key at every boot, which
# invalidates every signed token on each restart. Never ship a committed value.
JWT_SECRET=""

# WebSocket endpoint path
WS_PATH="/ws"

# Browser origins allowed to open WebSocket connections, comma-separated.
# Matched against the origin host[:port] — NOT a URL. `http://localhost:3000`
# here rejects every browser connection with 403. Empty falls back to WEB_URL.
WS_ORIGINS="localhost:3000"

# When set, device enrollment requires X-Enrollment-Secret. Leave unset only on
# a network you fully control. Generate one with `openssl rand -hex 16`.
ENROLLMENT_SECRET=""

# Redis (optional): enables Redis-backed rate limiting and
# distributed WebSocket pub/sub for multi-instance scaling.
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379/0"

# Public URL of the web dashboard (used for SSO callback URLs)
WEB_URL="http://localhost:3000"

# Directory served by GET /api/v2/installers
INSTALLERS_DIR="./dist/agents"

# How many days of metric history to keep (cold retention cutoff;
# the retention manager deletes older rows hourly)
METRIC_RETENTION_DAYS="365"
