# OurWay server environment template.
# Copy to .env (or export in your shell / container runtime).
# Every variable has a sensible default; none are strictly required,
# but JWT_SECRET and DATABASE_URL must be set sensibly in production.

# HTTP listen address (host:port)
SERVER_PORT=":8080"

# PostgreSQL connection string
DATABASE_URL="postgresql://ourway:ourway@localhost:5432/ourway?sslmode=disable"

# Secret key for JWT token signing. Generate your own and keep it private:
#   openssl rand -hex 32
# Leaving this unset gives the server a fresh random key at every boot, which
# invalidates every signed token on each restart. Never ship a committed value.
JWT_SECRET=""

# WebSocket endpoint path
WS_PATH="/ws"

# Browser origins allowed to open WebSocket connections, comma-separated.
# Matched against the origin host[:port] — NOT a URL. `http://localhost:3000`
# here rejects every browser connection with 403. Empty falls back to WEB_URL.
WS_ORIGINS="localhost:3000"

# When set, device enrollment requires X-Enrollment-Secret. Leave unset only on
# a network you fully control. Generate one with `openssl rand -hex 16`.
ENROLLMENT_SECRET=""

# Sustained per-user REST budget. The console is designed to live inside it and
# rests visibly ("LIMITED Ns") when it is spent. Raise for big shifts with many
# tabs open; it is a server-side dial, not a requirement.
RATE_LIMIT_PER_MINUTE="100"

# Instantaneous burst before the sustained rate applies. 0 = a tenth of the budget.
RATE_LIMIT_BURST="0"

# Redis (optional): enables Redis-backed rate limiting and
# distributed WebSocket pub/sub for multi-instance scaling.
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379/0"

# Public URL of the web dashboard (used for SSO callback URLs)
WEB_URL="http://localhost:3000"

# Directory served by GET /api/v2/installers
INSTALLERS_DIR="./dist/agents"

# How many days of metric history to keep (cold retention cutoff;
# the retention manager deletes older rows hourly)
METRIC_RETENTION_DAYS="365"
# 2.3-6: the audit ledger's window. Rows older than this are removed by the
# same hourly sweep that prunes metric history; the ledger page prints the
# window and the last sweep's counter.
AUDIT_RETENTION_DAYS="365"

# Mail transport (2.4-6): the server OurWay's email channels deliver through,
# its credentials, and the address it sends as. The recipients belong to the
# channel (config.to), not here — that is what makes "client A's criticals to the
# on-call mailbox" one row. With SMTP_HOST unset, email channels are refused at
# save time and the console states why.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="ourway@example.com"
# Refuse to send in clear when the server offers STARTTLS. Set false only for a
# relay on a network you control.
SMTP_STARTTLS="true"

# Remote-control session recording (2.4-8). off records nothing — the default,
# because recording is a promise to the people whose screens it shows. on records
# every session from its start; control-only records a session from the moment
# someone sends control input. An unparseable value is NOT read as a policy: the
# server prints what it received and records nothing.
RECORD_SESSIONS="off"
# Where the frame-sequence files live. This is media storage: the server does not
# back it up, it fills up, and it is not served over HTTP. Recordings past
# RECORDING_RETENTION_DAYS are pruned (rows, then files) by the same hourly sweep
# that prunes metric history and the audit ledger.
RECORDINGS_DIR="./dist/recordings"
RECORDING_RETENTION_DAYS="30"
