# Stale committed build artifact of the installer (rebuilt into dist/agents/ by docker/build-agents.sh)
cmd/ourway-installer/ourway-installer

# NOTE: cmd/ourway-installer/assets/agent is intentionally NOT gitignored.
# It is the tracked placeholder that //go:embed uses; docker/build-agents.sh
# overwrites it with the real agent binary at build time.

# Frontend build artifacts (built by docker/Dockerfile.web / npm run build)
web/dist/

# Frontend dependencies
web/node_modules/

# Impeccable design workspace: briefs, screenshots, detector scratch
.impeccable/

# Local coding-agent workspace (skill definitions the editor keeps in the repo).
# Nothing in the product reads it, and every file in it is a local path with local
# settings, so it stays untracked.
.opencode/

# Playwright e2e artifacts (2.2-0): HTML report, traces/videos, and the
# generated seed manifest. The manifest holds the seeded fleet's device keys,
# so it must never be committed.
web/playwright-report/
web/test-results/
web/e2e/.seed-manifest.json
web/e2e/.fake-agent.pid

# scripts/coverage.sh working files
.coverage-*.out

# Local deployment config: holds JWT_SECRET / ENROLLMENT_SECRET, plus the
# binaries scripts/ builds for a run. Only .env.example is committed.
.env

# Local scratch (built agent binaries for scripts/agent-smoke.sh, ...)
.tmp/

# `go build ./...` in cmd/ourway-cli writes ./cli next to main.go. It is a build
# artifact: CI builds it from source, nothing consumes a committed copy, and a
# 9 MB executable in git rewrites itself on every `scripts/release.sh` gate run —
# which dirties the tree the same script refuses to cut a release from.
cmd/ourway-cli/cli
