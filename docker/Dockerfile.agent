# OurWay RMM Agent - Linux Docker Image
#
# Build: docker build -f docker/Dockerfile.agent -t ourway/agent:latest .
# Run:   docker run -d --name ourway-agent \
#          -e OURWAY_SERVER=wss://ourway.example.com \
#          -e OURWAY_DEVICE_KEY=YOUR_KEY \
#          ourway/agent:latest
#
# This image is intended for running the OurWay agent inside a container.
# It connects to the OurWay server over WebSocket and reports metrics.

# Must match agent/go.mod (`go 1.24.0`) and the CI builder. This said 1.21 while
# agent/go.mod demanded 1.24.0 and CI built with 1.26: the image only worked
# because GOTOOLCHAIN=auto downloaded a newer toolchain mid-build, which is slow,
# invisible in review, and silently different from what CI ships.
FROM golang:1.27-alpine AS builder

WORKDIR /app

# Copy agent source
COPY agent/ ./

# Download dependencies
RUN go mod download

# Build static binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags "-s -w" -o ourway-agent .

# Final image - pinned to the line the server image already uses
# (docker/Dockerfile.server: alpine:3.20). `alpine:latest` made the agent image
# un-reproducible: one commit built a different rootfs from week to week.
FROM alpine:3.24

# Create non-root user
RUN addgroup -S ourway && adduser -S -G ourway ourway

# Install curl for healthcheck
RUN apk add --no-cache curl && rm -rf /var/cache/apk

# Copy agent binary
COPY --from=builder /app/ourway-agent /usr/local/bin/ourway-agent

# Run as non-root user
USER ourway

# Default environment (overridden at runtime)
ENV OURWAY_SERVER="" \
    OURWAY_DEVICE_KEY="" \
    OURWAY_HEARTBEAT="15s" \
    OURWAY_METRICS_INTERVAL="60s"

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -s http://localhost:8081/health || exit 1

ENTRYPOINT ["/usr/local/bin/ourway-agent"]
