# =============================================================================
# OurWay RMM Server - Multi-stage Docker build
# =============================================================================
# Build:   docker build -f docker/Dockerfile.server --build-arg VERSION=0.1.0 -t ourway/server .
# Run:     docker run -d -p 8080:8080 --name ourway-server ourway/server
# =============================================================================

# Build arguments
ARG VERSION=0.1.0
ARG GIT_COMMIT=unknown

# Stage 1: Build the Go server binary
FROM golang:1.26-alpine AS builder

ARG VERSION
ARG GIT_COMMIT

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Copy go mod files and download dependencies (layer caching)
COPY server/go.mod server/go.sum ./server/
WORKDIR /app/server
RUN go mod download

# Copy source code
COPY server/ ./
COPY agent/ ../agent/
COPY cmd/ourway-installer/ ../cmd/ourway-installer/

# Build the server binary with version info embedded
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT}" \
    -o /app/server_bin .

# Build agent binaries for all platforms (for agent download endpoint)
RUN mkdir -p /app/dist/agents \
    && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -C ../agent \
        -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT}" \
        -o /app/dist/agents/ourway-agent-linux-amd64 . \
    && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -C ../agent \
        -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT}" \
        -o /app/dist/agents/ourway-agent-linux-arm64 . \
    && CGO_ENABLED=0 GOOS=darwin GOARCH=amd64 go build -C ../agent \
        -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT}" \
        -o /app/dist/agents/ourway-agent-darwin-amd64 . \
    && CGO_ENABLED=0 GOOS=darwin GOARCH=arm64 go build -C ../agent \
        -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT}" \
        -o /app/dist/agents/ourway-agent-darwin-arm64 . \
    && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -C ../agent \
        -ldflags "-s -w -X main.Version=${VERSION} -X main.GitCommit=${GIT_COMMIT}" \
        -o /app/dist/agents/ourway-agent-windows-amd64.exe .

# Build self-contained installers for all platforms (agent binary embedded)
RUN for platform in "linux/amd64" "linux/arm64" "darwin/amd64" "darwin/arm64" "windows/amd64"; do \
    os="${platform%%/*}"; arch="${platform##*/}"; suffix=""; \
    if [ "$os" = "windows" ]; then suffix=".exe"; fi; \
    cp "/app/dist/agents/ourway-agent-${os}-${arch}${suffix}" /app/cmd/ourway-installer/assets/agent && \
    CGO_ENABLED=0 GOOS=$os GOARCH=$arch go build -C /app/cmd/ourway-installer \
        -ldflags "-s -w -X main.version=${VERSION} -X main.gitCommit=${GIT_COMMIT}" \
        -o "/app/dist/agents/ourway-installer-${os}-${arch}${suffix}" .; \
  done

# Stage 2: Minimal production image
FROM alpine:3.20

ARG VERSION

# Set metadata
LABEL org.opencontainers.image.title="OurWay RMM Server"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.description="OurWay Remote Monitoring & Management Server"

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S ourway \
    && adduser -S -G ourway ourway

# Create application directory
WORKDIR /app
RUN mkdir -p /app/data \
    && chown -R ourway:ourway /app

# Copy the built binary from the builder stage
COPY --from=builder /app/server_bin /app/server

# Copy agent binaries for the download endpoint
COPY --from=builder /app/dist/agents /app/dist/agents
RUN chown -R ourway:ourway /app/dist

# Switch to non-root user
USER ourway:ourway

# Expose the server port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget -q --spider http://localhost:8080/health || exit 1

# Environment defaults
ENV SERVER_PORT=:8080
ENV TZ=UTC

# Run the server
CMD ["/app/server"]
