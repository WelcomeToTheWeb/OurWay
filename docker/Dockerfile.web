# =============================================================================
# OurWay RMM Web Dashboard - Multi-stage Docker build
# =============================================================================
# Build:   docker build -f docker/Dockerfile.web -t ourway/web .
# Run:     docker run -d -p 3000:80 --name ourway-web ourway/web
# =============================================================================

# Stage 1: Build the React application
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY web/package.json web/package-lock.json ./

# Install dependencies
RUN npm ci --only=production=false

# Copy source code
COPY web/ ./

# Build the application
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf.bak 2>/dev/null || true

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy installation scripts
COPY install.sh /usr/share/nginx/html/
COPY install.ps1 /usr/share/nginx/html/

# Set ownership of nginx directories
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && chown -R nginx:nginx /run

# Switch to non-root user
USER nginx:nginx

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=5s \
    CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
